              "type": "object",
              "required": [
                "id",
                "parent",
                "child",
                "type",
                "address",
                "title",
                "editable"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "parent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "child": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "type": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "address": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "title": {
                  "type": "string",
                  "nullable": true
                },
                "value": {
                  "type": "string",
                  "nullable": true
                },
                "editable": {
                  "type": "boolean"
                }
              }
            }
