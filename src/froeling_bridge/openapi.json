{
  "openapi": "3.0.3",
  "info": {
    "title": "Fr\u00f6ling Bridge local prototype API",
    "version": "0.2.0",
    "description": "Simulator and read-only p4d database API. Loopback only. Jobs are bounded and ephemeral; never automatically replay writes. No physical controller integration."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/collector": {
      "get": {
        "operationId": "collector",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collector"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu": {
      "get": {
        "operationId": "menu",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Menu"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "parent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "default": 1
            }
          }
        ]
      }
    },
    "/api/v1/sensors": {
      "get": {
        "operationId": "sensors",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Items"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/values": {
      "get": {
        "operationId": "values",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Items"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "No controller cache in database mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history": {
      "get": {
        "operationId": "history",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Items"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65534
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{1,8}$"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Inclusive local ISO timestamp without timezone offset"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Exclusive local ISO timestamp without timezone offset"
            }
          },
          {
            "name": "aggregate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "S",
                "A"
              ],
              "default": "S"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          }
        ]
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "operationId": "jobs_get",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Job absent or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/jobs": {
      "post": {
        "operationId": "jobs_submit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted; poll Location for outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Database mode is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "This OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "JobRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "status"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "firmware"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "discover_menu"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "time_ranges"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "read_parameter"
                ]
              },
              "menu_id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "operation",
              "menu_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "write_parameter"
                ]
              },
              "menu_id": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "description": "Decimal string, HH:MM, or boolean according to the server-side menu type."
              }
            },
            "required": [
              "operation",
              "menu_id",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "measurement"
                ]
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65534
              },
              "type": {
                "type": "string",
                "enum": [
                  "VA",
                  "DO",
                  "DI",
                  "AO",
                  "UD"
                ]
              }
            },
            "required": [
              "operation",
              "address",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "write_time_range"
                ]
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 254
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "start": {
                "type": "string",
                "nullable": true,
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "end": {
                "type": "string",
                "nullable": true,
                "pattern": "^\\d{2}:\\d{2}$"
              }
            },
            "required": [
              "operation",
              "address",
              "index",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        ]
      },
      "JobAccepted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "state",
          "operation",
          "source",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "operation": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "description": "Typed protocol result; decimals are strings. Write status is confirmed or unchanged."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "actual": {}
            },
            "description": "Includes outcome_unknown or verification_failed for incomplete writes."
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "demo-db",
              "database"
            ]
          },
          "hardware_verified": {
            "type": "boolean"
          },
          "worker": {
            "type": "string"
          },
          "database_available": {
            "type": "boolean",
            "nullable": true
          },
          "jobs_persistent": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "mode",
          "hardware_verified",
          "worker",
          "database_available",
          "jobs_persistent",
          "timezone"
        ],
        "additionalProperties": false
      },
      "Collector": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "running": {
            "type": "boolean"
          },
          "interval_seconds": {
            "type": "number"
          },
          "last_cycle": {
            "type": "string",
            "nullable": true
          },
          "last_successful_store": {
            "type": "string",
            "nullable": true
          },
          "stored": {
            "type": "integer"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Items": {
        "type": "object",
        "required": [
          "source",
          "items"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Menu": {
        "type": "object",
        "required": [
          "source",
          "parent",
          "items",
          "cached",
          "timezone"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "parent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65534
          },
          "cached": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "parent",
                "child",
                "type",
                "address",
                "title",
                "editable"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "parent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "child": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "type": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "address": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65534
                },
                "title": {
                  "type": "string",
                  "nullable": true
                },
                "value": {
                  "type": "string",
                  "nullable": true
                },
                "editable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
