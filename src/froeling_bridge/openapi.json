          },
          "active": {
            "type": "boolean"
          },
          "recording": {
            "type": "boolean"
          },
          "supported": {
            "type": "boolean"
          },
          "factor": {
            "type": "integer"
          },
          "res1": {
            "type": "integer"
          },
          "latest": {
            "$ref": "#/components/schemas/LatestValue"
          }
        }
      },
      "Sensors": {
        "type": "object",
        "required": [
          "source",
          "items"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sensor"
            }
          }
        }
      }
