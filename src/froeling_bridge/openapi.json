      "Sensor": {
        "type": "object",
        "required": [
          "type",
          "address",
          "title",
          "unit",
          "state",
          "record",
          "active",
          "recording",
          "supported",
          "latest"
        ],
        "properties": {
          "type": {
            "type": "string",
