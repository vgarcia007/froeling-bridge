            "type": "number"
          },
          "stale": {
            "type": "boolean"
          },
          "origin": {
            "type": "string",
            "enum": [
              "controller",
              "local-persisted"
            ]
          },
          "source": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "address": {
            "type": "integer"
          }
        }
