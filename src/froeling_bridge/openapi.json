{
  "openapi": "3.0.3",
  "info": {
    "title": "Fröling Bridge API",
    "version": "0.5.6",
    "description": "Discover the controller catalogue through /sensors, match its title, then read latest on the same sensor. latest is a cached observation, never a new controller request. POST a measurement/status job for an explicit fresh read. Standalone operation does not require MariaDB. Heating writes require separate hardware validation."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Bridge host"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/collector": {
      "get": {
        "operationId": "collector",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collector"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu": {
      "get": {
        "operationId": "menu",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Menu"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "parent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "default": 1
            }
          }
        ]
      }
    },
    "/api/v1/sensors": {
      "get": {
        "operationId": "sensors",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sensors"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Discover all sensors and their latest known values",
        "description": "Includes inactive sensors and sensors absent from the service menu. Find a sensor by title/usrtitle; retain type+address. latest=null means no observation is available. This request does not contact the controller. In standalone mode recording is effective: UD 1..3 are always recorded like p4d applyConfigurationSpecials. configured_recording reflects the stored flag; recording_required identifies the automatic policy. No valuefacts flags are overwritten."
      }
    },
    "/api/v1/values": {
      "get": {
        "operationId": "values",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Items"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "No controller cache in database mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Read cached observations",
        "description": "Reads process memory only. Use observed_at, age_seconds, origin and stale. Does not query the controller or historical MariaDB values."
      }
    },
    "/api/v1/history": {
      "get": {
        "operationId": "history",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Items"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65534
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{1,8}$"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Inclusive local ISO timestamp without timezone offset"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Exclusive local ISO timestamp without timezone offset"
            }
          },
          {
            "name": "aggregate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "S",
                "A"
              ],
              "default": "S"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          }
        ]
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "operationId": "jobs_get",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Job absent or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/jobs": {
      "post": {
        "operationId": "jobs_submit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted; poll Location for outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Database mode is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Heating writes are disabled in hardware modes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "This OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu/search": {
      "get": {
        "operationId": "menu_search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "At most 100 matching menu items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Items"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/api/v1/time-programs": {
      "get": {
        "summary": "Named time programs and last successful cached controller read",
        "responses": {
          "200": {
            "description": "Menu-derived device/weekday labels plus cache values, observation time and refresh state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "source",
                    "programs",
                    "cache"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "programs": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "cache": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "time_programs"
      }
    },
    "/api/v1/sensors/{type}/{address}": {
      "patch": {
        "operationId": "configureSensor",
        "summary": "Choose collection and history independently of heating writes",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "active": {
                    "type": "boolean"
                  },
                  "record": {
                    "type": "boolean"
                  }
                }
              },
              "example": {
                "record": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selection saved locally; effective next cycle. Database synchronization may still be pending."
          },
          "400": {
            "description": "Invalid selection, unknown or unsupported sensor"
          },
          "403": {
            "description": "Sensor configuration unavailable in this mode"
          }
        }
      }
    },
    "/api/v1/runtime": {
      "get": {
        "operationId": "runtime",
        "summary": "Discovery, connection and optional history/aggregation state",
        "responses": {
          "200": {
            "description": "Standalone readiness and independent historian status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "phase": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string",
                      "nullable": true
                    },
                    "catalogue_ready": {
                      "type": "boolean"
                    },
                    "connection": {
                      "type": "object"
                    },
                    "history": {
                      "type": "object",
                      "nullable": true
                    },
                    "last_failure": {
                      "type": "object",
                      "nullable": true,
                      "description": "Most recent worker failure, retained after recovery. Protocol details contain request command and list entry, never raw operating values or arbitrary storage exception text.",
                      "properties": {
                        "phase": {
                          "type": "string"
                        },
                        "error_type": {
                          "type": "string"
                        },
                        "detail": {
                          "type": "string",
                          "nullable": true
                        },
                        "occurred_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/errors": {
      "get": {
        "summary": "Read heating error history, or current controller memory",
        "description": "Default source=auto reads all stored MariaDB occurrences in pages, like p4d, if a history database is configured. source=controller reads only the last complete persistent controller snapshot. Neither mode sends serial commands. Database failure in auto mode explicitly falls back to controller memory: fallback=true, history_available=false, history_error explains missing history. source=history requires MariaDB and returns 503 on failure, with no fallback. observed_at/stale/error still describe the last controller read; read_at is the database query time and history_sync describes its last synchronization. Use total, limit, offset and has_more to retrieve every page. Older stored rows and acknowledged states are retained.",
        "responses": {
          "200": {
            "description": "Error occurrences with explicit source, freshness, history availability and pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "available": {
                      "type": "boolean"
                    },
                    "stale": {
                      "type": "boolean"
                    },
                    "observed_at": {
                      "type": "string",
                      "nullable": true
                    },
                    "error": {
                      "type": "string",
                      "nullable": true
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "number": {
                            "type": "integer"
                          },
                          "state": {
                            "type": "string",
                            "enum": [
                              "gekommen",
                              "gegangen",
                              "quittiert"
                            ]
                          },
                          "text": {
                            "type": "string"
                          },
                          "time1": {
                            "type": "string",
                            "nullable": true,
                            "description": "Controller-local timestamp without timezone offset."
                          },
                          "time2": {
                            "type": "string",
                            "nullable": true,
                            "description": "Controller-local timestamp without timezone offset."
                          },
                          "time4": {
                            "type": "string",
                            "nullable": true,
                            "description": "Controller-local timestamp without timezone offset."
                          },
                          "id": {
                            "type": "integer",
                            "description": "Persistent MariaDB occurrence ID; absent in controller-only view."
                          }
                        }
                      }
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "p4d-database",
                        "controller-error-memory"
                      ]
                    },
                    "total": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "history_configured": {
                      "type": "boolean"
                    },
                    "history_available": {
                      "type": "boolean",
                      "nullable": true
                    },
                    "history_error": {
                      "type": "string",
                      "nullable": true
                    },
                    "fallback": {
                      "type": "boolean"
                    },
                    "read_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "history_sync": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unsupported mode or query parameters"
          },
          "503": {
            "description": "Explicit source=history requested, but history database is unavailable or not configured."
          }
        },
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "auto",
                "history",
                "controller"
              ],
              "default": "auto"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "JobRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "status"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "firmware"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "discover_menu"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "time_ranges"
                ]
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "read_parameter"
                ]
              },
              "menu_id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "operation",
              "menu_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "write_parameter"
                ]
              },
              "menu_id": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "description": "Decimal string, HH:MM, or boolean according to the server-side menu type."
              }
            },
            "required": [
              "operation",
              "menu_id",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "measurement"
                ]
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65534
              },
              "type": {
                "type": "string",
                "enum": [
                  "VA",
                  "DO",
                  "DI",
                  "AO",
                  "UD"
                ]
              }
            },
            "required": [
              "operation",
              "address",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "write_time_range"
                ]
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 254
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "start": {
                "type": "string",
                "nullable": true,
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "end": {
                "type": "string",
                "nullable": true,
                "pattern": "^\\d{2}:\\d{2}$"
              }
            },
            "required": [
              "operation",
              "address",
              "index",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "read_menu_value"
                ]
              },
              "menu_id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "operation",
              "menu_id"
            ],
            "additionalProperties": false
          }
        ]
      },
      "JobAccepted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "state",
          "operation",
          "source",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "operation": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "description": "Typed protocol result; decimals are strings. Write status is confirmed or unchanged."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "actual": {}
            },
            "description": "Includes outcome_unknown or verification_failed for incomplete writes."
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
